# Local development uses the embedded PostgreSQL instance started by the app.
# Set DATABASE_URL only when connecting to Supabase or another PostgreSQL server.
# That connection must be able to SET ROLE zann_app. Keep it on the server. Never expose it to the browser.

# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

PG_PORT=54329
PG_PASSWORD=replace-with-a-local-password
PG_DATABASE=zann_lab
PG_USER=postgres

# Signs the local session cookie. Use a long random string in every environment.
SESSION_SECRET=replace-with-a-long-random-string

# Protects the reminder job endpoint.
CRON_SECRET=replace-with-a-long-random-string

# Password for the fictional local accounts created by the demo seed.
# This is not a production credential.
SEED_PASSWORD=replace-with-a-local-demo-password
SEED_DEMO=true

# Public URL used in notification links.
APP_URL=http://localhost:3000

# Optional Supabase Auth. Leave blank to use local accounts.
# AUTH_PROVIDER=local
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=

# Optional email delivery. Leave blank to keep email skipped and in-app notifications active.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
